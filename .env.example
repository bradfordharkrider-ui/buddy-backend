# Copy this file to .env and fill in real values.
# .env should NEVER be committed to git or shared - it's in .gitignore already.

PORT=3000

# ── Login (password + Face ID / Touch ID) ─────────────────────
# Required once this is deployed publicly. APP_USERNAME/APP_PASSWORD are
# the password fallback. Leave both blank for local dev (no login).
APP_USERNAME=
APP_PASSWORD=

# SESSION_SECRET signs the login cookie - any random string, set once and
# don't change it later (changing it logs everyone out).
SESSION_SECRET=

# RP_ID/RP_ORIGIN must exactly match the real domain a passkey is
# registered on - a passkey registered on one origin cannot be used to
# sign in on another. Set these to your actual deployed domain, e.g.
# RP_ID=buddy-backend-ddwp.onrender.com
# RP_ORIGIN=https://buddy-backend-ddwp.onrender.com
RP_ID=localhost
RP_ORIGIN=http://localhost:3000

# ── Financial tab (Robinhood) ────────────────────────────────
# Robinhood's Agentic Trading connects to an AI platform account (e.g. via
# claude.ai Settings -> Connectors), not to a generic URL a custom backend
# can call - there's no ROBINHOOD_MCP_URL/account ID to fill in here. Real
# portfolio/position data instead comes from data/robinhood-snapshot.json,
# a point-in-time pull done by asking Claude (which has that connector) to
# refresh it. See README "Connecting Robinhood".
#
# When true, getPortfolio() reads data/robinhood-snapshot.json instead of
# shadow sample data. Trade execution stays simulated either way - see
# executeTrades() in src/lib/robinhoodClient.js.
ROBINHOOD_READ_LIVE=false

# Live ticker search (Financial tab "Research" section). Independent of
# Robinhood - calls Finnhub's free API directly for any ticker the user
# types, since there's no live Robinhood path for on-demand lookups here.
# Get a free key at https://finnhub.io. Leave blank to disable search
# (the fixed tier-ticker/holdings research list still works without it).
FINNHUB_API_KEY=

# ── Work tab (Outlook / Microsoft Graph) ─────────────────────
# Register an app at https://portal.azure.com (Azure AD App Registrations)
# to get these. See README "Connecting Outlook".
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# ── Work tab (Gmail / Google Calendar) ────────────────────────
# Create an OAuth client at https://console.cloud.google.com (APIs &
# Services -> Credentials -> Create Credentials -> OAuth client ID ->
# Web application), enable the Gmail API and Google Calendar API for
# the project, and add the redirect URI below as an authorized one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Safety gates (don't remove these) ────────────────────────
# When true, every trade/send/calendar-write action requires explicit
# confirmation and nothing executes automatically. Keep this true until
# you've tested thoroughly. This mirrors the manual-approval design
# agreed on for both Financial and Work tabs.
REQUIRE_MANUAL_CONFIRMATION=true

# When true, trade/email/calendar actions are logged and returned to the
# frontend as "would execute" without actually calling Robinhood/Graph.
# Turn this off only after you've verified the flows end-to-end.
SHADOW_MODE=true

# ── Render deploy automation (local machine only) ────────────
# Used only by scripts/push-to-render.mjs to push refreshed
# data/*.json snapshots straight to the deployed app's Secret Files,
# so you don't have to copy-paste JSON into the dashboard each time.
# Get a key from Render -> Account Settings -> API Keys.
RENDER_API_KEY=
RENDER_SERVICE_ID=
